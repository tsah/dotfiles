#!/usr/bin/env bash
# Clankerhouse exec sink (hooks.toml, sink "phone"): pushes a Status Event to Tsah's phone through
# the same ntfy topic as the AWS login notices (bin/xdg-open-via-laptop). Routed events today are
# routine.broken, routine.ended and message.undelivered; `clankers hooks test --sink phone` sends a sample.
# Event JSON arrives on stdin. Exit 0 = pushed (or deliberately dropped); nonzero = retry.
# The topic is a secret: it is read from env or an owner-only file and never printed or logged.
set -uo pipefail

if [ -f "$HOME/.env" ]; then
    set +u
    # shellcheck disable=SC1091
    . "$HOME/.env"
    set -u
fi

read_config_value() {
    [ -r "$1" ] || return 1
    IFS= read -r value < "$1"
    [ -n "$value" ] || return 1
    printf '%s\n' "$value"
}

event=$(cat)
type=$(jq -r '.type // empty' <<<"$event" 2>/dev/null) || exit 0
[ -n "$type" ] || exit 0

NTFY_URL="${REMOTE_OPEN_NTFY_URL:-$(read_config_value "$HOME/.config/dotfiles/ntfy-url" || true)}"
NTFY_URL="${NTFY_URL:-https://ntfy.sh}"
NTFY_TOPIC="${REMOTE_OPEN_NTFY_TOPIC:-$(read_config_value "$HOME/.config/dotfiles/ntfy-topic" || true)}"
if [ -z "$NTFY_TOPIC" ]; then
    echo "phone-push: no ntfy topic; set REMOTE_OPEN_NTFY_TOPIC or ~/.config/dotfiles/ntfy-topic" >&2
    exit 1
fi

name=$(jq -r '.details.name // .title // .details.routineId // "clanker"' <<<"$event")
where=$(jq -r '.workshop // .worktree // empty' <<<"$event")
summary=$(jq -r '.summary // empty' <<<"$event")
host=$(jq -r '.host // empty' <<<"$event")
case "$type" in
    routine.broken) title="Routine broken: ${name}"; tags="warning"; priority="high" ;;
    routine.ended) title="Routine ended: ${name}"; tags="stop_sign"; priority="high" ;;
    message.undelivered) title="Message not delivered: ${name}"; tags="envelope,warning"; priority="high" ;;
    hooks.test) title="Clankerhouse test push"; tags="test_tube"; priority="default" ;;
    *) title="Clankerhouse ${type}: ${name}"; tags="robot"; priority="default" ;;
esac
body=$(printf '%s\n%s%s' "$summary" "${where:+Workshop: ${where}}" "${host:+ on ${host}}")
body="${body}
See: clankers needs-me"

# The title is an HTTP header: keep it to printable ASCII.
title=$(printf '%s' "$title" | LC_ALL=C tr -cd '[:print:]' | cut -c1-120)
set -- -fsS --max-time 10 \
    -H "Title: ${title}" \
    -H "Priority: ${priority}" \
    -H "Tags: ${tags}" \
    -d "${body}" \
    "${NTFY_URL%/}/${NTFY_TOPIC}"
if [ -r "$HOME/.config/dotfiles/ntfy-auth-header" ]; then
    # File holds 'Authorization: Bearer tk_...'; @file keeps it out of ps.
    set -- -H "@$HOME/.config/dotfiles/ntfy-auth-header" "$@"
fi
# curl's own errors can quote the URL, which holds the topic: keep them out of logs.
curl "$@" >/dev/null 2>&1
