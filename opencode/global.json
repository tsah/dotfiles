{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "default_agent": "build",
  "plugins": [
    {
      "package": "./plugins/plannotator-shortcuts.ts"
    },
    {
      "package": "@plannotator/opencode@latest",
      "options": {
        "workflow": "manual"
      }
    },
    {
      "package": "@ishaksebsib/opencode-tree",
      "options": {
        "storageScope": "global"
      }
    }
  ],
  "lsp": false,
  "permission": {
    "external_directory": {
      "/**": "allow"
    }
  },
  "agent": {
    "build": {
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "variant": "low",
      "color": "#3498DB"
    }
  }
}
