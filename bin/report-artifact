#!/usr/bin/env python3
"""Render one long-lived Claude artifact page per report, with every run's history inside it.

Usage: report-artifact DESK PAGE_NAME TITLE MARKDOWN_FILE
  Appends {title, when, markdown} to ~/.local/state/reports/DESK/history.json, renders
  ~/.local/state/reports/DESK/artifact.html (newest run open, earlier runs folded below),
  and prints that file's path. Publish the file with the Artifact tool; the artifact's URL
  is kept in ~/.local/state/reports/DESK/artifact_url (written by the caller after publish).
  PAGE_NAME is the artifact's stable <title>, e.g. "Merged PRs digest".
Markdown support is publish-report's (headings, nested bullets, bold, italic, code, links, quotes).
"""
import html
import json
import sys
from datetime import datetime
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path
from zoneinfo import ZoneInfo

_loader = SourceFileLoader("publish_report", str(Path(__file__).with_name("publish-report")))
_spec = spec_from_loader("publish_report", _loader)
publish_report = module_from_spec(_spec)
_loader.exec_module(publish_report)
render = publish_report.render

TZ = ZoneInfo("Europe/Amsterdam")
KEEP = 60  # runs kept in the page

CSS = """
/* Layout: one reading column; the newest run as open cards, earlier runs as folded rows. */
:root{--bg:#f5f6f4;--card:#ffffff;--text:#1c211f;--muted:#5f6a65;--line:#dfe4e1;--accent:#2f6f5e;--code:#eef1ef;
--display:"Space Grotesk",ui-sans-serif,system-ui,sans-serif;--body:"Inter",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#151917;--card:#1e2421;--text:#e6ebe8;--muted:#9aa6a0;--line:#313a36;--accent:#7cc4ad;--code:#27302c;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#151917;--card:#1e2421;--text:#e6ebe8;--muted:#9aa6a0;--line:#313a36;--accent:#7cc4ad;--code:#27302c;color-scheme:dark}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--text);font:16px/1.55 var(--body);padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
main{max-width:720px;margin:0 auto;padding-block:28px 64px;display:flex;flex-direction:column;gap:14px}
header{display:flex;flex-direction:column;gap:4px}
.eyebrow{font:600 12px/1 var(--body);letter-spacing:.08em;text-transform:uppercase;color:var(--accent)}
h1{font:600 28px/1.2 var(--display);margin:0;text-wrap:balance}
.meta{color:var(--muted);font-size:14px}
section.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px 18px;min-width:0}
h2{font:600 18px/1.3 var(--display);margin:0 0 10px;text-wrap:balance}
h3{font:600 13px/1.3 var(--body);letter-spacing:.04em;text-transform:uppercase;margin:16px 0 6px;color:var(--muted)}
ul{margin:6px 0;padding-left:20px}
li{margin:6px 0;overflow-wrap:anywhere}
li::marker{color:var(--accent)}
a{color:var(--accent);text-decoration:none}
a:hover,a:focus-visible{text-decoration:underline}
a:focus-visible,summary:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:4px}
code{background:var(--code);border-radius:5px;padding:1px 5px;font-size:.9em;overflow-wrap:anywhere}
blockquote{margin:8px 0;padding:4px 12px;border-left:3px solid var(--line);color:var(--muted)}
p{margin:8px 0}
.earlier{display:flex;flex-direction:column;gap:8px;margin-top:18px}
.earlier>h2{font-size:15px;color:var(--muted);margin:0}
details{background:var(--card);border:1px solid var(--line);border-radius:10px}
summary{cursor:pointer;padding:12px 16px;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;list-style:none}
summary::-webkit-details-marker{display:none}
summary .t{font-weight:600}
summary .w{color:var(--muted);font-size:14px;font-variant-numeric:tabular-nums}
details[open] summary{border-bottom:1px solid var(--line)}
details .run{padding:4px 12px 12px;display:flex;flex-direction:column;gap:10px}
details section.card{border:0;padding:8px 6px}
"""


def main():
    desk, page_name, title, md_path = sys.argv[1], sys.argv[2], sys.argv[3], Path(sys.argv[4])
    state = Path.home() / ".local/state/reports" / desk
    state.mkdir(parents=True, exist_ok=True)
    hist_file = state / "history.json"
    history = json.loads(hist_file.read_text()) if hist_file.exists() else []
    history.append({"title": title, "when": datetime.now(TZ).strftime("%a %d %b %Y, %H:%M"), "markdown": md_path.read_text()})
    history = history[-KEEP:]
    hist_file.write_text(json.dumps(history, indent=1))

    latest, earlier = history[-1], list(reversed(history[:-1]))
    folded = "".join(
        f'<details><summary><span class="t">{html.escape(r["title"])}</span><span class="w">{html.escape(r["when"])}</span></summary>'
        f'<div class="run">{render(r["markdown"])}</div></details>'
        for r in earlier
    )
    out = f"""<title>{html.escape(page_name)}</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Space+Grotesk:wght@600&display=swap">
<style>{CSS}</style>
<main>
<header><span class="eyebrow">{html.escape(page_name)} · latest</span><h1>{html.escape(latest["title"])}</h1><span class="meta">{html.escape(latest["when"])} · {len(history)} runs kept</span></header>
{render(latest["markdown"])}
{f'<div class="earlier"><h2>Earlier runs</h2>{folded}</div>' if earlier else ''}
</main>
"""
    page = state / "artifact.html"
    page.write_text(out)
    print(page)


if __name__ == "__main__":
    main()
