#!/bin/bash

window_address=$(hyprctl clients -j | jq -r '.[] | select(.class == "persistent-terminal" or .class == "omarchy.persistentterminal") | .address' | head -1)
if [[ -n "$window_address" ]]; then
    hyprctl dispatch "hl.dsp.focus({ window = \"address:$window_address\" })"
    exit 0
fi

hyprctl dispatch 'hl.dsp.exec_cmd([[uwsm-app -- ghostty --config-file=$HOME/dotfiles/ghostty-persistent.conf]], { workspace = "1" })'
