#!/usr/bin/env python3
"""Check manifest installation and real Worktrunk layouts in a disposable HOME."""
import json
import os
from pathlib import Path
import subprocess
import tempfile

source = Path(__file__).resolve().parent.parent
with tempfile.TemporaryDirectory(prefix="dotfiles-worktrunk-") as directory:
    root = Path(directory)
    home = root / "home"
    home.mkdir()
    env = {
        "PATH": os.environ["PATH"], "HOME": str(home), "SHELL": "/bin/bash",
        "DOTFILES_DIR": str(source), "GIT_CONFIG_NOSYSTEM": "1", "GIT_CONFIG_GLOBAL": "/dev/null",
        "WORKTRUNK_SYSTEM_CONFIG_PATH": str(root / "absent-system.toml"),
    }
    for key, relative in {
        "XDG_CONFIG_HOME": "home/.config", "XDG_DATA_HOME": "data", "XDG_STATE_HOME": "state",
        "XDG_CACHE_HOME": "cache", "XDG_RUNTIME_DIR": "runtime",
    }.items():
        path = root / relative
        path.mkdir(parents=True, mode=0o700)
        env[key] = str(path)

    def run(*args):
        result = subprocess.run(args, cwd=root, env=env, capture_output=True, text=True, timeout=60)
        if result.returncode:
            raise RuntimeError(f"{args}:\n{result.stdout}\n{result.stderr}")
        return result.stdout

    run(str(source / "bin/dotfiles-install"), "server")
    config = home / ".config/worktrunk/config.toml"
    assert config.is_symlink() and config.resolve() == source / "worktrunk/config.toml", config
    linked_at = config.lstat().st_mtime_ns
    run(str(source / "bin/dotfiles-install"), "server")
    assert config.lstat().st_mtime_ns == linked_at, "Reinstall must not churn already-correct links"

    ordinary = root / "ordinary repo"
    run("git", "init", "-q", "-b", "main", str(ordinary))
    run("git", "-C", str(ordinary), "-c", "user.name=QA", "-c", "user.email=qa@example.invalid",
        "commit", "--allow-empty", "-qm", "seed")
    bare = root / "bare repo"
    bare.mkdir()
    run("git", "clone", "--bare", str(ordinary), str(bare / ".git"))

    def switch(repo, branch, create=True):
        flags = ["--create"] if create else []
        return Path(json.loads(run("wt", "-C", str(repo), "switch", *flags, branch,
                                   "--no-cd", "--no-hooks", "--format", "json", "--yes"))["path"])

    assert switch(ordinary, "feature/clean") == root / "ordinary repo.feature-clean"
    assert switch(bare, "feature/clean") == bare / "feature-clean"
    # A checkout made by the old default is kept exactly where it is.
    existing = bare / ".git.existing"
    run("git", "-C", str(bare), "worktree", "add", "-b", "existing", str(existing), "main")
    assert switch(bare, "existing", create=False) == existing
    assert existing.is_dir()

print("Worktrunk config QA passed: manifest link, bare and ordinary layouts, sanitized branches, existing checkout preservation.")
