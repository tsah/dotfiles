#!/bin/bash

set -euo pipefail

[[ -f ~/.config/user-dirs.dirs ]] && source ~/.config/user-dirs.dirs

OUTPUT_DIR="${OMARCHY_SCREENSHOT_DIR:-${XDG_PICTURES_DIR:-$HOME/Pictures}}"
REMOTE_TARGET="${SCREENSHOT_REMOTE_TARGET:-}"
DEVBOX_INVENTORY="${DEVBOX_INVENTORY_COMMAND:-$HOME/dotfiles/bin/devbox-inventory}"
NOTIFY_APP="screenshot-share"

notify_user() {
  local level="$1"
  local title="$2"
  local body="${3:-}"
  local timeout="${4:-5000}"
  local sent=1

  if command -v notify-send >/dev/null 2>&1; then
    if [[ -n "$body" ]]; then
      if [[ "$level" == "error" ]]; then
        notify-send -a "$NOTIFY_APP" "$title" "$body" -u critical -t "$timeout" >/dev/null 2>&1 && sent=0
      else
        notify-send -a "$NOTIFY_APP" "$title" "$body" -t "$timeout" >/dev/null 2>&1 && sent=0
      fi
    else
      if [[ "$level" == "error" ]]; then
        notify-send -a "$NOTIFY_APP" "$title" -u critical -t "$timeout" >/dev/null 2>&1 && sent=0
      else
        notify-send -a "$NOTIFY_APP" "$title" -t "$timeout" >/dev/null 2>&1 && sent=0
      fi
    fi
  fi

  if (( sent != 0 )) && command -v hyprctl >/dev/null 2>&1; then
    local icon=1
    local color="0"

    case "$level" in
    success)
      icon=5
      color="rgb(88cc88)"
      ;;
    error)
      icon=3
      color="rgb(ff4444)"
      ;;
    *)
      icon=1
      color="0"
      ;;
    esac

    local message="$title"
    [[ -n "$body" ]] && message="$title: $body"
    hyprctl notify "$icon" "$timeout" "$color" "$message" >/dev/null 2>&1 || true
  fi
}

if [[ ! -d "$OUTPUT_DIR" ]]; then
  notify_user error "Screenshot directory does not exist" "$OUTPUT_DIR" 3000
  exit 1
fi

pkill slurp >/dev/null 2>&1 && exit 0

MODE="${1:-smart}"
case "$MODE" in
smart|region|windows|fullscreen) ;;
*)
  notify_user error "Unknown screenshot mode" "$MODE"
  exit 2
  ;;
esac

pick_menu_item() {
  local title="$1"
  shift
  local menu_items
  menu_items=$(printf '%s\n' "$@")

  if command -v omarchy-menu-select >/dev/null 2>&1; then
    omarchy menu select "$title" "$@" -- --width 340 --maxheight 240
  elif command -v walker >/dev/null 2>&1; then
    printf "%s" "$menu_items" | walker --dmenu --width 340 --minheight 180 --maxheight 240 --placeholder "$title"
  elif command -v fuzzel >/dev/null 2>&1; then
    printf "%s" "$menu_items" | fuzzel --dmenu --prompt "$title"
  elif command -v wofi >/dev/null 2>&1; then
    printf "%s" "$menu_items" | wofi --dmenu --prompt "$title"
  else
    printf '%s' "$1"
  fi
}

pick_destination() {
  pick_menu_item "Screenshot destination" clipboard local remote
}

pick_remote_target() {
  if [[ -n "$REMOTE_TARGET" ]]; then
    printf '%s' "$REMOTE_TARGET"
    return
  fi

  if [[ ! -x "$DEVBOX_INVENTORY" ]]; then
    notify_user error "Devbox inventory unavailable" "$DEVBOX_INVENTORY"
    return 1
  fi

  local names=()
  mapfile -t names < <("$DEVBOX_INVENTORY" names)
  if (( ${#names[@]} == 0 )); then
    notify_user error "No screenshot targets" "Add a devbox with setup-new-devbox"
    return 1
  fi

  local selected
  selected=$(pick_menu_item "Screenshot devbox" "${names[@]}" || true)
  selected=$(printf '%s' "$selected" | tr -d '\r' | xargs)
  [[ -n "$selected" ]] || return 1

  if [[ "$selected" =~ ^[0-9]+$ ]] && (( selected < ${#names[@]} )); then
    selected="${names[$selected]}"
  fi

  "$DEVBOX_INVENTORY" target "$selected"
}

normalize_destination() {
  local raw="$1"
  local cleaned

  cleaned=$(printf "%s" "$raw" | tr -d '\r' | xargs)
  cleaned=${cleaned,,}

  case "$cleaned" in
  0) cleaned="clipboard" ;;
  1) cleaned="local" ;;
  2) cleaned="remote" ;;
  esac

  printf "%s" "$cleaned"
}

copy_path_to_clipboards() {
  local value="$1"

  if ! command -v wl-copy >/dev/null 2>&1; then
    return 1
  fi

  if printf "%s" "$value" | wl-copy --type text/plain; then
    printf "%s" "$value" | wl-copy --primary --type text/plain >/dev/null 2>&1 || true
    return 0
  fi

  return 1
}

format_copy_value() {
  local value="$1"
  local strip_remote_host="${2:-false}"

  if [[ "$strip_remote_host" == "true" && "$value" =~ ^[^:]+:(/.*)$ ]]; then
    value="${BASH_REMATCH[1]}"
  fi

  printf '"%s"' "$value"
}

upload_remote() {
  local file_path="$1"
  local target
  target=$(pick_remote_target) || return 1

  if [[ -z "$target" ]]; then
    notify_user error "Remote target not configured" "Add an entry to devboxes.tsv"
    return 1
  fi

  local destination="$target"
  if [[ "$target" == */ ]]; then
    destination="${target}$(basename "$file_path")"
  fi

  if scp -q "$file_path" "$destination"; then
    local copied_value
    copied_value=$(format_copy_value "$destination" true)

    if copy_path_to_clipboards "$copied_value"; then
      notify_user success "Screenshot uploaded" "$copied_value (path copied)"
    else
      if command -v wl-copy >/dev/null 2>&1; then
        notify_user success "Screenshot uploaded" "$destination"
        notify_user error "Clipboard copy failed" "Could not copy remote path"
      else
        notify_user success "Screenshot uploaded" "$destination"
      fi
    fi
  else
    notify_user error "Screenshot upload failed" "$destination"
    return 1
  fi
}

OUTPUT_FILE=$(omarchy capture screenshot "$MODE" save) || exit 1
[[ -z "$OUTPUT_FILE" || ! -f "$OUTPUT_FILE" ]] && exit 0

# Keep the unedited capture separate so canceling the editor does not continue
# into the destination menu with a screenshot the user chose not to save.
RAW_FILE=$(mktemp --tmpdir="$OUTPUT_DIR" .screenshot-share.XXXXXX.png)
mv -- "$OUTPUT_FILE" "$RAW_FILE"
trap 'rm -f "$RAW_FILE"' EXIT

if command -v tensaku >/dev/null 2>&1; then
  tensaku --filename "$RAW_FILE" --output-filename "$OUTPUT_FILE" --early-exit --actions-on-enter save-to-file || true
elif command -v satty >/dev/null 2>&1; then
  satty --filename "$RAW_FILE" --output-filename "$OUTPUT_FILE" --early-exit --actions-on-enter save-to-file || true
else
  mv -- "$RAW_FILE" "$OUTPUT_FILE"
fi

rm -f "$RAW_FILE"
trap - EXIT
[[ ! -f "$OUTPUT_FILE" ]] && exit 0

DESTINATION_RAW=$(pick_destination || true)
DESTINATION=$(normalize_destination "$DESTINATION_RAW")
case "$DESTINATION" in
clipboard)
  if command -v wl-copy >/dev/null 2>&1; then
    wl-copy --type image/png <"$OUTPUT_FILE"
    notify_user success "Screenshot copied" "Copied image to clipboard"
  else
    notify_user error "wl-copy not available" "Screenshot kept locally at $OUTPUT_FILE"
  fi
  ;;
local)
  copied_value=""
  copied_value=$(format_copy_value "$OUTPUT_FILE")

  if copy_path_to_clipboards "$copied_value"; then
    notify_user success "Screenshot saved" "$copied_value (path copied)"
  else
    if command -v wl-copy >/dev/null 2>&1; then
      notify_user success "Screenshot saved" "$OUTPUT_FILE"
      notify_user error "Clipboard copy failed" "Could not copy local path"
    else
      notify_user success "Screenshot saved" "$OUTPUT_FILE"
    fi
  fi
  ;;
remote)
  upload_remote "$OUTPUT_FILE"
  ;;
"")
  exit 0
  ;;
*)
  notify_user error "Unknown destination" "$DESTINATION_RAW"
  exit 1
  ;;
esac
