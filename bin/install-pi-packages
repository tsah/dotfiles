#!/bin/sh
set -eu

if ! command -v pi >/dev/null 2>&1; then
    echo "pi is required. Run the platform package installer first." >&2
    exit 1
fi

# Local Pi packages are loaded in place, so Pi does not install their runtime
# dependencies as it does for npm and git packages.
SLOPCHOP_DIR=${PI_SLOPCHOP_DIR:-"$HOME/dev/personal/pi-slopchop"}
if [ -f "$SLOPCHOP_DIR/package-lock.json" ]; then
    npm ci --omit=dev --prefix "$SLOPCHOP_DIR"
fi

pi install npm:@tintinweb/pi-subagents@0.14.0
