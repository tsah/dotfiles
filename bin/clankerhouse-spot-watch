#!/bin/sh
set -eu
PATH="$HOME/.local/bin:$HOME/.bun/bin:$HOME/.opencode/bin:$HOME/.local/share/mise/shims:$HOME/.local/share/mise/installs/node/latest/bin:${PATH:-/usr/local/bin:/usr/bin:/usr/local/sbin:/usr/sbin}"
export PATH
DOTFILES_DIR=${DOTFILES_DIR:-"$HOME/dotfiles"}
CLANKERHOUSE_SPOT_CHECKPOINT_COMMAND=${CLANKERHOUSE_SPOT_CHECKPOINT_COMMAND:-"$DOTFILES_DIR/bin/clankers recovery checkpoint"}
export CLANKERHOUSE_SPOT_CHECKPOINT_COMMAND
exec python3 "$DOTFILES_DIR/clankerhouse/spot_watch.py" "$@"
