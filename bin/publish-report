#!/usr/bin/env python3
"""Publish a markdown report as a self-contained page under ~/reports, served on the tailnet.

Usage: publish-report DESK TITLE MARKDOWN_FILE
       publish-report --root     (rebuild only ~/reports/index.html, for desks that render their own pages)
  Writes ~/reports/DESK/runs/<stamp>.html, rebuilds ~/reports/DESK/index.html (every run,
  newest first) and ~/reports/index.html (every desk), and prints the run page's URL.

Serving: user systemd unit `reports-server` (python http.server on 127.0.0.1:8790) behind
`tailscale serve --set-path /reports`, so pages open at https://puffin.tail685506.ts.net/reports/.
Markdown support: #/##/### headings, - and nested bullets, **bold**, *italic*, `code`, [links](url),
> quotes, and paragraphs.
"""
import html
import json
import re
import sys
from datetime import datetime
from pathlib import Path
from zoneinfo import ZoneInfo

ROOT = Path.home() / "reports"
BASE_URL = "https://puffin.tail685506.ts.net/reports"
TZ = ZoneInfo("Europe/Amsterdam")

CSS = """
:root{--bg:#f7f6f3;--card:#fff;--text:#1f1e1c;--muted:#6b6862;--line:#e6e3dd;--accent:#c2603a;--code:#f1efea}
@media (prefers-color-scheme:dark){:root:not([data-theme=light]){--bg:#1b1a18;--card:#252421;--text:#ecebe7;--muted:#a19d95;--line:#383631;--accent:#e08a63;--code:#2f2d29}}
:root[data-theme=dark]{--bg:#1b1a18;--card:#252421;--text:#ecebe7;--muted:#a19d95;--line:#383631;--accent:#e08a63;--code:#2f2d29}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font:16px/1.55 ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}
main{max-width:760px;margin:0 auto;padding:24px 16px 64px}
header{margin-bottom:20px}
.crumbs{font-size:13px;color:var(--muted)}
.crumbs a{color:var(--muted)}
h1{font-size:26px;line-height:1.25;margin:6px 0 4px;letter-spacing:-.01em}
.meta{color:var(--muted);font-size:14px}
section.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px 18px;margin:14px 0}
h2{font-size:18px;margin:0 0 10px}
h3{font-size:15px;margin:16px 0 6px;color:var(--muted);text-transform:none}
ul{margin:6px 0;padding-left:20px}
li{margin:6px 0}
li::marker{color:var(--accent)}
a{color:var(--accent);text-decoration:none}
a:hover{text-decoration:underline}
code{background:var(--code);border-radius:5px;padding:1px 5px;font-size:.9em;word-break:break-word}
blockquote{margin:8px 0;padding:4px 12px;border-left:3px solid var(--line);color:var(--muted)}
p{margin:8px 0}
.runs li{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}
.runs .when{color:var(--muted);font-size:14px;white-space:nowrap}
"""


def inline(text):
    out, pos = [], 0
    for m in re.finditer(r"\[([^\]]+)\]\(([^)\s]+)\)|`([^`]+)`|\*\*([^*]+)\*\*|\*([^*]+)\*", text):
        out.append(html.escape(text[pos:m.start()]))
        if m.group(1) is not None:
            out.append(f'<a href="{html.escape(m.group(2), quote=True)}">{inline(m.group(1))}</a>')
        elif m.group(3) is not None:
            out.append(f"<code>{html.escape(m.group(3))}</code>")
        elif m.group(4) is not None:
            out.append(f"<strong>{inline(m.group(4))}</strong>")
        else:
            out.append(f"<em>{inline(m.group(5))}</em>")
        pos = m.end()
    out.append(html.escape(text[pos:]))
    return "".join(out)


def render(md):
    """Markdown -> HTML; each ## section becomes a card."""
    lines, out, stack, para, in_card = md.splitlines(), [], [], [], False

    def flush_para():
        if para:
            out.append(f"<p>{inline(' '.join(para))}</p>")
            para.clear()

    def close_lists(depth=0):
        while len(stack) > depth:
            out.append("</li></ul>")
            stack.pop()

    for raw in lines:
        line = raw.rstrip()
        bullet = re.match(r"^(\s*)[-*] (.*)$", line)
        if bullet:
            flush_para()
            depth = len(bullet.group(1).replace("\t", "  ")) // 2 + 1
            if depth > len(stack):
                while depth > len(stack):
                    out.append("<ul><li>")
                    stack.append(depth)
            else:
                close_lists(depth)
                out.append("</li><li>")
            out.append(inline(bullet.group(2)))
            continue
        if stack and line.startswith("  ") and line.strip():
            out.append(" " + inline(line.strip()))
            continue
        close_lists()
        heading = re.match(r"^(#{1,3}) (.*)$", line)
        if heading:
            flush_para()
            level = len(heading.group(1))
            if level <= 2:
                if in_card:
                    out.append("</section>")
                out.append('<section class="card">')
                in_card = True
                out.append(f"<h2>{inline(heading.group(2))}</h2>")
            else:
                out.append(f"<h3>{inline(heading.group(2))}</h3>")
        elif line.startswith("> "):
            flush_para()
            out.append(f"<blockquote>{inline(line[2:])}</blockquote>")
        elif not line.strip():
            flush_para()
        else:
            para.append(line.strip())
    flush_para()
    close_lists()
    if in_card:
        out.append("</section>")
    body = "\n".join(out)
    return body if in_card else f'<section class="card">{body}</section>'


def page(title, crumbs, meta, body):
    return f"""<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{html.escape(title)}</title><style>{CSS}</style></head>
<body><main><header><div class="crumbs">{crumbs}</div><h1>{html.escape(title)}</h1><div class="meta">{html.escape(meta)}</div></header>
{body}
</main></body></html>
"""


def rebuild_root():
    desks = sorted(d for d in ROOT.iterdir() if (d / "index.html").exists())
    items = "".join(f'<li><a href="{d.name}/">{html.escape(d.name)}</a></li>' for d in desks)
    (ROOT / "index.html").write_text(page(
        "Reports", "puffin", f"{len(desks)} desks", f'<section class="card"><ul class="runs">{items}</ul></section>',
    ))


def rebuild_indexes(desk_dir):
    runs = json.loads((desk_dir / "runs.json").read_text())
    items = "".join(
        f'<li><a href="runs/{r["file"]}">{html.escape(r["title"])}</a><span class="when">{html.escape(r["when"])}</span></li>'
        for r in reversed(runs)
    )
    (desk_dir / "index.html").write_text(page(
        desk_dir.name, '<a href="../">All reports</a>', f"{len(runs)} reports",
        f'<section class="card"><ul class="runs">{items}</ul></section>',
    ))
    rebuild_root()


def main():
    if sys.argv[1:] == ["--root"]:
        rebuild_root()
        return
    desk, title, md_path = sys.argv[1], sys.argv[2], Path(sys.argv[3])
    now = datetime.now(TZ)
    desk_dir = ROOT / desk
    (desk_dir / "runs").mkdir(parents=True, exist_ok=True)
    name = now.strftime("%Y-%m-%d-%H%M") + ".html"
    when = now.strftime("%a %d %b %Y, %H:%M")
    crumbs = f'<a href="../../">All reports</a> · <a href="../">{html.escape(desk)}</a>'
    (desk_dir / "runs" / name).write_text(page(title, crumbs, when, render(md_path.read_text())))
    runs_file = desk_dir / "runs.json"
    runs = json.loads(runs_file.read_text()) if runs_file.exists() else []
    runs.append({"file": name, "title": title, "when": when})
    runs_file.write_text(json.dumps(runs, indent=1))
    rebuild_indexes(desk_dir)
    print(f"{BASE_URL}/{desk}/runs/{name}")


main()
