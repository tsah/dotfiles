#!/bin/sh
# xdg-open shim for headless dev hosts. Forwards the URL/path to the user's
# laptop over Tailscale so links open in the local browser. Symlinked to
# ~/.local/bin/xdg-open by install-server.sh — do not link on the laptop
# itself or it shadows the real xdg-open.
set -eu

# Explicit configuration wins because SSH_CLIENT can be a jump host. The
# setup-new-devbox command writes these files without embedding machine names
# in this script. Environment variables remain available as overrides.
if [ -f "$HOME/.env" ]; then
    set +u
    . "$HOME/.env"
    set -u
fi

read_config_value() {
    [ -r "$1" ] || return 1
    IFS= read -r value < "$1"
    [ -n "$value" ] || return 1
    printf '%s\n' "$value"
}

CLIENT_HOST="${SSH_CLIENT:-}"
CLIENT_HOST="${CLIENT_HOST%% *}"
LAPTOP="${REMOTE_OPEN_HOST:-}"
if [ -z "$LAPTOP" ]; then
    LAPTOP=$(read_config_value "$HOME/.config/dotfiles/remote-open-host" || true)
fi
LAPTOP="${LAPTOP:-$CLIENT_HOST}"
[ -n "$LAPTOP" ] || {
    echo "xdg-open: no laptop target; run setup-new-devbox or set REMOTE_OPEN_HOST" >&2
    exit 1
}

DEV_HOST="${REMOTE_OPEN_LOCALHOST_HOST:-}"
if [ -z "$DEV_HOST" ]; then
    DEV_HOST=$(read_config_value "$HOME/.config/dotfiles/devbox-host" || true)
fi
DEV_HOST="${DEV_HOST:-$(hostname)}"

if [ "$#" -eq 0 ]; then
    echo "usage: xdg-open <url|path>" >&2
    exit 2
fi

target=$1
case "$target" in
    http://localhost:*|https://localhost:*|http://127.0.0.1:*|https://127.0.0.1:*)
        scheme=${target%%://*}
        rest=${target#*://}
        rest=${rest#localhost}
        rest=${rest#127.0.0.1}
        target="${scheme}://${DEV_HOST}${rest}"
        shift
        set -- "$target" "$@"
        ;;
esac

IDENTITY="${REMOTE_OPEN_IDENTITY:-$HOME/.ssh/id_ed25519_remote_open}"
if [ -f "$IDENTITY" ]; then
    exec ssh \
        -i "$IDENTITY" \
        -o IdentitiesOnly=yes \
        -o BatchMode=yes \
        -o ConnectTimeout=5 \
        -o StrictHostKeyChecking=accept-new \
        "$LAPTOP" "$@"
fi

# Backward compatibility for devboxes enrolled before the dedicated key was
# introduced.
exec ssh \
    -o BatchMode=yes \
    -o ConnectTimeout=5 \
    -o StrictHostKeyChecking=accept-new \
    "$LAPTOP" "$@"
