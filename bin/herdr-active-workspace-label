#!/bin/sh
set -eu

workspace_id=${HERDR_ACTIVE_WORKSPACE_ID:-}
[ -n "$workspace_id" ] || exit 0

herdr_bin=${HERDR_BIN_PATH:-}
if [ -z "$herdr_bin" ]; then
    herdr_bin=$(command -v herdr 2>/dev/null) || exit 0
fi

"$herdr_bin" workspace get "$workspace_id" 2>/dev/null \
    | jq -r '.result.workspace.label // empty' 2>/dev/null \
    | tail -n 1
