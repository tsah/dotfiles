[Unit]
Description=Clankerhouse conservative clanker resource-pressure guard
Documentation=file:%h/dotfiles/clankerhouse/README.md
ConditionPathExists=/proc/pressure/memory
After=default.target clankerhouse-recovery.service
Wants=clankerhouse-recovery.service

[Service]
Type=simple
ExecStart=%h/dotfiles/bin/clankerhouse-resource-guard
Restart=on-failure
RestartSec=10s
TimeoutStopSec=15s
NoNewPrivileges=true
# The guard must inspect the same /tmp/tmux-$UID socket as interactive clients.

[Install]
WantedBy=default.target
