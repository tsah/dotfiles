#!/bin/bash

active_workspace=$(hyprctl activeworkspace -j | jq -r '.id')
clients=$(hyprctl clients -j)
mapfile -t windows < <(jq -r "[.[] | select(.workspace.id == $active_workspace and .floating == false)] | .[].address" <<<"$clients")
[[ ${#windows[@]} -ge 2 ]] || exit 0

grouped_count=$(jq "[.[] | select(.address == \"${windows[0]}\")] | .[0].grouped | length" <<<"$clients")
focus_window() {
    hyprctl dispatch "hl.dsp.focus({ window = \"address:$1\" })"
}

focus_window "${windows[0]}"
if [[ "$grouped_count" -gt 0 ]]; then
    hyprctl dispatch 'hl.dsp.group.toggle()'
    exit 0
fi

hyprctl dispatch 'hl.dsp.group.toggle()'
for pass in 1 2 3; do
    for address in "${windows[@]:1}"; do
        is_grouped=$(hyprctl clients -j | jq "[.[] | select(.address == \"$address\")] | .[0].grouped | length")
        [[ "$is_grouped" -gt 0 ]] && continue

        focus_window "$address"
        for direction in l r u d; do
            hyprctl dispatch "hl.dsp.window.move({ into_group = \"$direction\" })"
        done
    done

    ungrouped=$(hyprctl clients -j | jq "[.[] | select(.workspace.id == $active_workspace and .floating == false and (.grouped | length == 0))] | length")
    [[ "$ungrouped" -eq 0 ]] && break
done

focus_window "${windows[0]}"
