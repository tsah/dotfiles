#!/bin/bash

# Find an empty workspace, send the focused window there, and keep it on the current monitor.
current_monitor=$(hyprctl activeworkspace -j | jq -r '.monitor')
used_workspaces=$(hyprctl workspaces -j | jq -r '.[] | select(.windows > 0) | .id' | sort -n)

empty_workspace=1
for workspace in $(seq 1 100); do
    if ! grep -qx "$workspace" <<<"$used_workspaces"; then
        empty_workspace=$workspace
        break
    fi
done

focused_window=$(hyprctl activewindow -j | jq -r '.address')
[[ -n "$focused_window" && "$focused_window" != "null" ]] || exit 0

hyprctl dispatch "hl.dsp.window.move({ workspace = \"$empty_workspace\", follow = false, window = \"address:$focused_window\" })"
hyprctl dispatch "hl.dsp.workspace.move({ workspace = \"$empty_workspace\", monitor = \"$current_monitor\" })"
hyprctl dispatch "hl.dsp.focus({ workspace = \"$empty_workspace\" })"
